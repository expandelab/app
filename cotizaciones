  if(client){
    const d = CLIENTS[client];
    const base = month==null ? d.pct : (monthlyRevenue[month] ? +(d.monthly[month]/monthlyRevenue[month]*100).toFixed(2) : 0);
    const rest = +(100-base).toFixed(2);
    return { center: month==null?fmtK(TOTAL_ALL):fmtK(monthlyRevenue[month]),
      slices:[ {name:client, pct:base, color:COLORS.gold}, {name:'Resto de la cartera', pct:rest, color:COLORS.otros} ] };
  }

  if(mode==='risk'){
    const top6 = RISK_CLIENTS.slice(0,6).map((c,i)=>({name:c.name, pct:c.pct, color:PALETTE[i]}));
    const otherRiskPct = +(RISK_TOTAL/TOTAL_ALL*100 - top6.reduce((s,c)=>s+c.pct,0)).toFixed(2);
    const healthyPct = +(100 - RISK_TOTAL/TOTAL_ALL*100).toFixed(2);
    return { center: fmtK(TOTAL_ALL), slices:[...top6,
      {name:'Otros clientes en riesgo', pct:Math.max(otherRiskPct,0), color:'#7a2e2e'},
      {name:'Cartera sin riesgo', pct:healthyPct, color:COLORS.otros}] };
  }

  const n = mode==='top' ? 10 : 6;
  const top = topClientsBy(n, month);
  const denom = month==null ? TOTAL_ALL : monthlyRevenue[month];
  const shown = top.reduce((s,c)=>s+c.total,0);
  const restPct = +((denom-shown)/denom*100).toFixed(2);
  const nOthers = N_CLIENTS - top.length;
  const slices = top.map(c=>({name:c.name, pct:c.pct, color:c.color}));
  if(restPct>0.05) slices.push({name:`Otros (${nOthers} clientes)`, pct:restPct, color:COLORS.otros});
  return { center: month==null?fmtK(TOTAL_ALL):fmtK(monthlyRevenue[month]), slices };
}

// Serie de linea segun el estado
function computeLine(){
  const { client, month } = state;

  if(client){
    const d = CLIENTS[client];
    if(month!=null){
      // mismo cliente, con el mes seleccionado resaltado (punto mas grande)
      return { labels: MONTHS, showAxis2:false,
        datasets:[{ label:client, data:d.monthly, color:COLORS.gold,
          pointRadii: MONTHS.map((_,i)=> i===month?7:3) }] };
    }
    const scaleRef = monthlyRevenue.map(v => v * (Math.max(...d.monthly,1) / Math.max(...monthlyRevenue)));
    return { labels: MONTHS, showAxis2:false,
      datasets:[
        { label:client, data:d.monthly, color:COLORS.gold, pointRadii: MONTHS.map(()=>4) },
        { label:'Ref. cartera (escalada)', data:scaleRef, color:'#4a4f5c', dash:[3,3], pointRadii: MONTHS.map(()=>2.5) },
      ]};
  }

  if(month!=null){
    // drill-down diario del mes seleccionado
    const days = DAILY[month];
    const labels = days.map((_,i)=> String(i+1).padStart(2,'0'));
    return { labels, showAxis2:false, daily:true,
      datasets:[{ label:MONTHS_FULL[month], data:days, color:COLORS.gold, pointRadii: days.map(()=>2) }] };
  }

  return { labels: MONTHS, showAxis2:true,
    datasets:[
      { label:'Ingresos', data:monthlyRevenue, color:COLORS.gold, yAxisID:'y', pointRadii: MONTHS.map(()=>4) },
      { label:'# Cotizaciones', data:monthlyCount, color:COLORS.lime, yAxisID:'y1', dash:[4,4], pointRadii: MONTHS.map(()=>2.5) },
    ]};
}

// Barras de contribucion
function computeContrib(){
  const { mode, client, month } = state;
  if(client){
    const d = CLIENTS[client];
    const denom = d.total || 1;
    return { label:'Contribución mensual', sub:'% del total del cliente',
      bars: MONTHS.map((m,i)=>({ label:m, val:d.monthly[i], pct:+(d.monthly[i]/denom*100).toFixed(1), highlight: i===month })) };
  }
  if(mode==='risk'){
    return { label:'Top clientes en riesgo', sub:'% de la cartera total',
      bars: RISK_CLIENTS.slice(0,6).map(c=>({ label:c.name, val:c.total, pct:c.pct, caption:c.reason, color: c.type==='inactivo'?COLORS.gray:COLORS.red })) };
  }
  const n = mode==='top' ? 10 : 6;
  const top = topClientsBy(n, month);
  return { label:`Contribución por cliente (top ${n})`, sub: month==null ? '% del total pagado' : `% de ${MONTHS_FULL[month]}`,
    bars: top.map(c=>({ label:c.name, val:c.total, pct:c.pct, color:c.color })) };
}

// Filas de tabla
function computeTable(){
  const { mode, client, month } = state;

  if(client){
    const d = CLIENTS[client];
    return { head:['Mes','Total pagado','% del cliente','vs mes anterior'],
      rows: MONTHS.map((m,i)=>{
        const val = d.monthly[i], prev = i>0?d.monthly[i-1]:null;
        let delta = '—';
        if(prev!=null){
          if(prev===0 && val>0) delta = 'nuevo';
          else if(prev>0){ const p=(val-prev)/prev*100; delta = `${p>=0?'▲':'▼'} ${Math.abs(p).toFixed(0)}%`; }
        }
        return { cells:[m, fmt(val), pct1(d.total?val/d.total*100:0), delta], hi: i===month };
      }) };
  }

  if(mode==='risk'){
    return { head:['Cliente','Motivo','Meses inactivo','Total pagado','% cartera'],
      rows: RISK_CLIENTS.map(c=>({ cells:[c.name, c.reason, c.type==='inactivo'?c.monthsInactive:'—', fmt(c.total), pct1(c.pct)], type:c.type })) };
  }

  const n = mode==='top' ? 10 : 12;
  const top = topClientsBy(n, month);
  return { head:['Cliente','Cotizaciones','Total pagado','Ticket prom.','% del total'],
    rows: top.map(c=>({ cells:[c.name, c.count, fmt(c.total), c.count?fmt(c.total/c.count):'—', pct1(c.pct)] })) };
}

// Panel de tipo de cliente (Empresa/Persona) — exacto por mes ya que 'tipo' es propiedad fija del cliente
function computeSegments(){
  const { client, month } = state;
  if(client){
    const d = CLIENTS[client];
    const activeMonths = d.monthly.filter(v=>v>0).length;
    const bestIdx = d.monthly.indexOf(Math.max(...d.monthly));
    return { isProfile:true, rows:[
      ['Tipo de cliente', d.tipo],
      ['Meses activos', `${activeMonths} / 8`],
      ['Mejor mes', `${MONTHS[bestIdx]} · ${fmt(d.monthly[bestIdx])}`],
      ['Frecuencia de compra', `${(d.count/Math.max(activeMonths,1)).toFixed(1)} / mes activo`],
    ]};
  }
  const entries = clientEntries(month);
  const totalDenom = entries.reduce((s,c)=>s+c.total,0) || 1;
  const groups = {};
  entries.forEach(c=>{ groups[c.tipo] = (groups[c.tipo]||0) + c.total; });
  const order = ['Empresa (RUC)','Persona (DNI)','Otro'];
  const colors = { 'Empresa (RUC)':COLORS.gold, 'Persona (DNI)':COLORS.blue, 'Otro':COLORS.gray };
  const segs = order.filter(k=>groups[k]!=null).map(k=>({ label:k, pct:+(groups[k]/totalDenom*100).toFixed(1), color:colors[k] }));
  return { isProfile:false, segs };
}

// Panel de alerta / insight
function computeFlag(){
  const { mode, client, month } = state;
  if(client){
    const d = CLIENTS[client];
    const risky = RISK_CLIENTS.find(r=>r.name===client);
    if(risky){
      return { ok:false, icon:'⚠', title:'Cuenta en riesgo', body:
        `<b>${client}</b> está marcado en riesgo: ${risky.reason}. Representa <b>${pct1(risky.pct)}</b> de tus ingresos totales — conviene contactarlo antes de perder la cuenta.` };
    }
    if(d.pct>=5){
      return { ok:false, icon:'★', title:'Cuenta clave', body:
        `<b>${client}</b> representa el <b>${pct1(d.pct)}</b> de tus ingresos pagados totales. Es una cuenta clave: formaliza condiciones comerciales y monitorea su actividad de cerca.` };
    }
    return { ok:true, icon:'✓', title:'Cuenta de cartera regular', body:
      `<b>${client}</b> representa el <b>${pct1(d.pct)}</b> de los ingresos totales, con <b>${d.count}</b> cotizaciones pagadas entre ${d.first} y ${d.last}. Sin riesgo de concentración individual.` };
  }
  if(month!=null){
    const top = topClientsBy(3, month);
    const rev = monthlyRevenue[month];
    const sum3 = top.reduce((s,c)=>s+c.total,0);
    return { ok:false, icon:'ℹ', title:`Concentración en ${MONTHS_FULL[month]}`, body:
      `Los 3 clientes principales de <b>${MONTHS_FULL[month]}</b> (${top.map(c=>c.name).join(', ')}) concentran el <b>${pct1(sum3/rev*100)}</b> de los ingresos de ese mes.` };
  }
  if(mode==='risk'){
    return { ok:false, icon:'⚠', title:'Riesgo de abandono — detalle', body:
      `<b>${RISK_CLIENTS.length} de ${N_CLIENTS} clientes</b> (${pct1(RISK_CLIENTS.length/N_CLIENTS*100)}) muestran señales de abandono, representando <b>${pct1(RISK_TOTAL/TOTAL_ALL*100)}</b> de tus ingresos totales. Prioriza contacto directo con los de mayor "% cartera" en la tabla — son los que más impacto tendrían si se van.` };
  }
  if(mode==='top'){
    const top10sum = topClientsBy(10,null).reduce((s,c)=>s+c.total,0);
    return { ok:false, icon:'⚠', title:'Riesgo de concentración', body:
      `El <b>top 10 de clientes</b> concentra el <b>${pct1(top10sum/TOTAL_ALL*100)}</b> de los ingresos pagados. Vale la pena diversificar la cartera y asegurar contratos/SLAs con las cuentas top.` };
  }
  return { ok:false, icon:'⚠', title:'Riesgo de concentración', body:
    `El <b>top 10 de clientes</b> concentra el <b>67.2%</b> de los ingresos pagados, y un solo cliente (AVI COURIER) representa el <b>19.2%</b>. Vale la pena diversificar la cartera y asegurar contratos/SLAs con las cuentas top.` };
}

/* ===================================================================
   RENDER FUNCTIONS — toman el resultado de compute*() y pintan el DOM
   =================================================================== */

function renderKPIs(k){
  const set = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = val; };

  // La tarjeta principal reutiliza su propio label (primer nodo de texto, antes del icono "?")
  const eyebrowText = document.getElementById('kpiMain').closest('.stat-card').querySelector('.eyebrow').childNodes[0];
  eyebrowText.nodeValue = k.label.toUpperCase()+' ';
  set('kpiMain', k.main);
  const badgeEl = document.getElementById('kpiBadge');
  badgeEl.textContent = k.badge;
  badgeEl.className = 'text-[11px] font-bold mt-1.5 mono ' + (k.badge && k.badge.startsWith('▼') ? 'down' : 'up');

  set('kpiTile1Val', k.tile1Val);
  set('kpiTile1Label', k.tile1Label);
  set('kpiTile2Val', k.tile2Val);
  set('kpiTile2Label', k.tile2Label);
  set('kpiTile3Val', k.tile3Val);
  set('kpiTile3Label', k.tile3Label);
  set('kpiTile4Val', k.tile4Val);
  set('kpiTile5Label', k.tile5Label);
  set('kpiTile5Val', k.tile5Val);
}

let donutChart, lineChart;

function renderDonut(d){
  document.getElementById('donutCenter').textContent = d.center;
  if(donutChart) donutChart.destroy();
  donutChart = new Chart(document.getElementById('donutClientes'), {
    type:'doughnut',
    data:{ labels: d.slices.map(s=>s.name), datasets:[{ data: d.slices.map(s=>s.pct), backgroundColor: d.slices.map(s=>s.color), borderColor:'#0d0f16', borderWidth:3, hoverOffset:10 }] },
    options:{
      cutout:'68%',
      onClick:(evt, els)=>{
        if(!els.length) return;
        const idx = els[0].index;
        const label = d.slices[idx].name;
        if(CLIENTS[label]){ state.client = label; state.month = state.month; syncControls(); render(); }
      },
      plugins:{ legend:{display:false}, tooltip:{
        backgroundColor:'#12141c', borderColor:'#262a36', borderWidth:1, padding:10, titleColor:'#f2f3f6', bodyColor:'#9aa0ae',
        callbacks:{ label:(ctx)=> ' '+ctx.label+': '+ctx.raw+'%' } } }
    }
  });
  const legendEl = document.getElementById('donutLegend');
  legendEl.innerHTML = '';
  d.slices.forEach(s=>{
    const row = document.createElement('div');
    row.className = 'flex items-center justify-between gap-3' + (CLIENTS[s.name] ? ' cursor-pointer hover:opacity-80' : '');
    row.innerHTML = `<span class="flex items-center gap-2 text-[--text-mid] truncate"><span class="w-2 h-2 rounded-full shrink-0" style="background:${s.color}"></span><span class="truncate" title="${s.name}">${s.name}</span></span><span class="mono font-semibold shrink-0">${s.pct}%</span>`;
    if(CLIENTS[s.name]) row.addEventListener('click', ()=>{ state.client = s.name; syncControls(); render(); });
    legendEl.appendChild(row);
  });
}

function renderLine(ld){
  document.getElementById('lineFootnote').style.display = (!state.client && state.month==null) ? '' : 'none';
  document.getElementById('lineLegendText').innerHTML = ld.datasets.map(ds=>
    `<span class="flex items-center gap-1.5"><span class="w-2 h-2 inline-block" style="background:${ds.color}"></span>${ds.label.length>26?ds.label.slice(0,26)+'…':ds.label}</span>`).join('');
  document.getElementById('lineLabel').textContent = ld.daily ? `INGRESOS DIARIOS · ${ld.datasets[0].label.toUpperCase()}` : (state.client ? `INGRESOS MENSUALES · ${state.client.toUpperCase()}` : 'INGRESOS / MES');

  if(lineChart) lineChart.destroy();
  const scales = {
    x:{ grid:{ color:'#161821' }, ticks:{ color:'#5c6273', font:{family:"'JetBrains Mono'",size: ld.daily?9:11}, maxRotation:0, autoSkip:true, maxTicksLimit: ld.daily?10:12 } },
    y:{ position:'left', grid:{ color:'#161821' }, ticks:{ color:'#5c6273', font:{family:"'JetBrains Mono'",size:10}, callback:(v)=>'S/'+(v/1000).toFixed(0)+'K' } },
  };
  if(ld.showAxis2) scales.y1 = { position:'right', grid:{ display:false }, ticks:{ color:'#5c6273', font:{family:"'JetBrains Mono'",size:10} } };

  lineChart = new Chart(document.getElementById('lineChart'), {
    type:'line',
    data:{ labels: ld.labels, datasets: ld.datasets.map(ds => ({
      label: ds.label, data: ds.data, borderColor: ds.color, backgroundColor: ds.color+'14',
      borderWidth: ds.dash && ds.dash.length ? 1.5 : 2.5, borderDash: ds.dash || [],
      pointBackgroundColor: ds.color, pointRadius: ds.pointRadii || 3, pointHoverRadius:7,
      tension:.35, yAxisID: ds.yAxisID || 'y', fill: !ld.daily ? false : true,
    })) },
    options:{
      responsive:true, maintainAspectRatio:false,
      interaction:{ mode:'index', intersect:false },
      plugins:{ legend:{ display:false },
        tooltip:{ backgroundColor:'#12141c', borderColor:'#262a36', borderWidth:1, padding:10, titleColor:'#f2f3f6', bodyColor:'#9aa0ae',
          callbacks:{ label:(ctx)=> '  '+ctx.dataset.label+': '+(ctx.dataset.yAxisID==='y1' ? ctx.raw : fmt(ctx.raw)) } } },
      scales
    }
  });
}

function renderContrib(c){
  document.getElementById('contribLabel').textContent = c.label.toUpperCase();
  document.getElementById('contribSubLabel').textContent = c.sub;
  document.getElementById('clientBars').innerHTML = c.bars.map(b=>`
    <div class="py-3 first:pt-0 last:pb-0 ${b.highlight ? 'bg-[#d9b25c0d] -mx-2 px-2 rounded-md' : ''}">
      <div class="flex items-center justify-between mb-1.5 gap-3">
        <span class="text-[13.5px] font-semibold truncate">${b.label}</span>
        <span class="mono text-[13.5px] font-bold shrink-0">${b.pct}%</span>
      </div>
      ${b.caption ? `<div class="text-[11px] text-[--text-low] mb-1.5">${b.caption}</div>` : ''}
      <div class="bar-track h-1.5"><div class="h-1.5 rounded-md" style="width:${Math.min(Math.max(b.pct,2)*(c.bars.length>8?4:3),100)}%;background:${b.color||COLORS.gold}"></div></div>
    </div>`).join('');
}

function renderTable(t){
  document.getElementById('tableHead').innerHTML = t.head.map((h,i)=>
    `<th class="pb-3 ${i===0?'pr-3':'text-right'} font-semibold">${h}</th>`).join('');
  document.getElementById('tableBody').innerHTML = t.rows.map(r=>{
    const cells = r.cells.map((v,i)=>{
      if(i===0) return `<td class="py-3 pr-3 font-medium">${v}</td>`;
      const goldLast = i===r.cells.length-1;
      return `<td class="py-3 text-right mono ${goldLast?'font-semibold':'text-[--text-mid]'}" ${goldLast?'style="color:var(--gold)"':''}>${v}</td>`;
    }).join('');
    const rowClass = r.hi ? 'bg-[#d9b25c0d]' : (r.type==='inactivo' ? 'bg-[#7b83940a]' : (r.type==='caida' ? 'bg-[#f871710a]' : ''));
    return `<tr class="${rowClass}">${cells}</tr>`;
  }).join('');
}

function renderSegments(s){
  document.getElementById('segmentLabel').textContent = s.isProfile ? 'PERFIL DEL CLIENTE' : 'TIPO DE CLIENTE';
  const body = document.getElementById('segmentBody');
  if(s.isProfile){
    body.innerHTML = s.rows.map(([label,val],i)=>`
      <div class="flex justify-between text-[13px] py-1.5 ${i>0?'border-t':''}" style="border-color:var(--line-soft)">
        <span class="text-[--text-mid]">${label}</span><span class="font-semibold text-right">${val}</span>
      </div>`).join('');
  } else {
    body.innerHTML = s.segs.map(seg=>`
      <div>
        <div class="flex justify-between text-[13px] mb-1">
          <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full" style="background:${seg.color}"></span>${seg.label}</span>
          <span class="mono font-semibold">${seg.pct}%</span>
        </div>
        <div class="bar-track h-2"><div class="h-2 rounded-md" style="width:${seg.pct}%;background:${seg.color}"></div></div>
      </div>`).join('');
  }
}

function renderFlag(f){
  const panel = document.getElementById('flagPanel');
  panel.classList.toggle('ok', !!f.ok);
  document.getElementById('flagIcon').textContent = f.icon;
  document.getElementById('flagIcon').className = f.ok ? 'up text-sm' : 'text-[--red] text-sm';
  const titleEl = document.getElementById('flagTitle');
  titleEl.textContent = f.title.toUpperCase();
  titleEl.className = 'text-[12px] font-bold mono uppercase tracking-wide ' + (f.ok ? 'up' : 'text-[--red]');
  document.getElementById('flagBody').innerHTML = f.body;
}

/* ===================================================================
   MAIN DISPATCH
   =================================================================== */
function renderCharts(){
  renderDonut(computeDonut());
  renderLine(computeLine());
}

function render(){
  ['linePanel','contribPanel','tablePanel','donutPanel','segmentPanel','flagPanel'].forEach(id=>{
    const el = document.getElementById(id);
    el.classList.remove('fade-in'); void el.offsetWidth; el.classList.add('fade-in');
  });
  renderKPIs(computeKPIs());
  renderCharts();
  renderContrib(computeContrib());
  renderTable(computeTable());
  renderSegments(computeSegments());
  renderFlag(computeFlag());
}

/* ===================================================================
   CONTROLS: chips, selects, sidebar drawer
   =================================================================== */
function syncControls(){
  document.getElementById('clientSelect').value = state.client || '';
  document.getElementById('monthSelect').value = state.month==null ? '' : state.month;
  document.querySelectorAll('.chip').forEach(c=>{
    c.classList.toggle('active', !state.client && state.month==null && c.dataset.f===state.mode);
    c.classList.toggle('risk-active', c.dataset.f==='risk' && !state.client && state.month==null && state.mode==='risk');
  });
}

// populate client select
const clientSelectEl = document.getElementById('clientSelect');
clientSelectEl.appendChild(new Option('👥 Todos los clientes',''));
Object.keys(CLIENTS).sort((a,b)=>CLIENTS[b].total-CLIENTS[a].total).forEach(name=>{
  clientSelectEl.appendChild(new Option(`${name} · ${fmt(CLIENTS[name].total)}`, name));
});
clientSelectEl.addEventListener('change', ()=>{
  state.client = clientSelectEl.value || null;
  if(!state.client) state.mode = 'all';
  syncControls(); render();
});

// populate month select
const monthSelectEl = document.getElementById('monthSelect');
monthSelectEl.appendChild(new Option('📅 Todos los meses',''));
MONTHS_FULL.forEach((m,i)=> monthSelectEl.appendChild(new Option(m, i)));
monthSelectEl.addEventListener('change', ()=>{
  const v = monthSelectEl.value;
  state.month = v==='' ? null : +v;
  if(state.month!=null) state.mode='all';
  syncControls(); render();
});

// chips
document.querySelectorAll('.chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    state.mode = chip.dataset.f;
    state.client = null; state.month = null;
    syncControls(); render();
  });
});

// sidebar drawer (mobile)
const sidebarEl = document.getElementById('sidebar');
const overlayEl = document.getElementById('drawerOverlay');
function openDrawer(){ sidebarEl.classList.add('open'); overlayEl.classList.add('open'); }
function closeDrawer(){ sidebarEl.classList.remove('open'); overlayEl.classList.remove('open'); }
document.getElementById('hamburgerBtn').addEventListener('click', openDrawer);
document.getElementById('sbClose').addEventListener('click', closeDrawer);
overlayEl.addEventListener('click', closeDrawer);
document.querySelectorAll('.sb-item').forEach(it=> it.addEventListener('click', closeDrawer));

/* ---- INIT ---- */
syncControls();
render();

</script>
