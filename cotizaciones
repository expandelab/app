    <div class="sb-item" title="Config">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
      <span class="lbl">Config</span>
    </div>
    <div class="sb-spacer"></div>
    <div class="sb-avatar">DL</div>
  </aside>

  <!-- MAIN -->
  <div class="main">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="flex items-center gap-3 min-w-0">
        <div class="hamburger" id="hamburgerBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </div>
        <div class="crumbs">
          <span>ExpandeLab</span><span>/</span><b>Cotizaciones</b><span>/</span><span>2026</span>
        </div>
      </div>
      <div class="sb-avatar hidden sm:flex">DL</div>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <div class="mb-5">
        <h1 class="disp text-[22px] md:text-[26px] font-bold tracking-tight">Cotizaciones Pagadas</h1>
        <p class="text-[12.5px] text-[--text-mid] mt-1 mono">03.01.2026 → 11.08.2026 · estado <span class="text-[--lime]">PAGADA</span> · 1,667 registros</p>
      </div>

      <!-- FILTER BAR -->
      <div class="filterbar no-scrollbar">
        <div class="chip active" data-f="all">TODO</div>
        <div class="chip" data-f="top">TOP 10</div>
        <div class="chip" data-f="risk">⚠ RIESGO</div>
        <div class="fb-sep"></div>
        <select class="fselect" id="clientSelect"></select>
        <select class="fselect" id="monthSelect"></select>
      </div>

      <!-- STAT ROW -->
      <div class="flex gap-3 overflow-x-auto no-scrollbar pb-1 snap-x snap-mandatory sm:grid sm:grid-cols-2 sm:gap-4 lg:grid-cols-5 mb-6" id="statRow">
        <div class="stat-card shrink-0 w-[76%] snap-start sm:w-auto">
          <div class="glow" style="background:var(--gold)"></div>
          <div class="eyebrow mb-2 has-tip" data-tip="Suma de todas las cotizaciones con estado Pagada en el periodo o filtro activo.">INGRESOS<span class="tip-ic">?</span></div>
          <div class="disp text-[22px] md:text-[24px] font-bold mono" id="kpiMain">S/ 1,159,381</div>
          <div class="up text-[11px] font-bold mt-1.5 mono" id="kpiBadge">▲ 22.8% JUL vs ENE</div>
        </div>
        <div class="stat-card shrink-0 w-[76%] snap-start sm:w-auto">
          <div class="eyebrow mb-2 has-tip" data-tip="Total pagado dividido entre el número de cotizaciones del filtro activo.">TICKET PROMEDIO<span class="tip-ic">?</span></div>
          <div class="disp text-[22px] md:text-[24px] font-bold mono" id="kpiTile1Val">S/ 696</div>
          <div class="text-[11px] text-[--text-low] mt-1.5 mono" id="kpiTile1Label">por cotización</div>
        </div>
        <div class="stat-card shrink-0 w-[76%] snap-start sm:w-auto">
          <div class="eyebrow mb-2 has-tip" data-tip="Número de cotizaciones pagadas dentro del filtro activo.">COTIZACIONES<span class="tip-ic">?</span></div>
          <div class="disp text-[22px] md:text-[24px] font-bold mono" id="kpiTile2Val">1,667</div>
          <div class="text-[11px] text-[--text-low] mt-1.5 mono" id="kpiTile2Label">pagadas al 11/08</div>
        </div>
        <div class="stat-card shrink-0 w-[76%] snap-start sm:w-auto">
          <div class="eyebrow mb-2 has-tip" data-tip="Clientes distintos con al menos una cotización pagada dentro del filtro activo.">CLIENTES<span class="tip-ic">?</span></div>
          <div class="disp text-[22px] md:text-[24px] font-bold mono" id="kpiTile3Val">158</div>
          <div class="text-[11px] text-[--text-low] mt-1.5 mono" id="kpiTile3Label">con ≥1 cotización pagada</div>
        </div>
        <div class="stat-card shrink-0 w-[76%] snap-start sm:w-auto">
          <div class="glow" style="background:var(--lime)"></div>
          <div class="eyebrow mb-2 has-tip" data-tip="% de clientes que pagaron 2 o más cotizaciones en el periodo completo.">TASA DE RECOMPRA<span class="tip-ic">?</span></div>
          <div class="disp text-[22px] md:text-[24px] font-bold mono" id="kpiTile4Val" style="color:var(--lime)">73.4%</div>
          <div class="text-[11px] text-[--text-low] mt-1.5 mono has-tip" data-tip="% de clientes activos en un mes que vuelven a comprar al mes siguiente (promedio ene-jul)."><span id="kpiTile5Label">retención M/M</span>: <span id="kpiTile5Val" class="text-[--text-hi]">66.2%</span></div>
