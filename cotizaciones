<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>ExpandeLab · Cotizaciones Pagadas 2026</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-0:#05070B; --bg-sidebar:#08090d; --panel:#0b0d13; --panel-2:#0e1017;
    --line:#1d212c; --line-soft:#161a23;
    --text-hi:#f4f5f7; --text-mid:#9aa0ae; --text-low:#565c6c;
    --gold:#d9b25c; --lime:#c7f22d; --green:#4ade80; --red:#f87171;
    --blue:#6fa8ff; --purple:#b98cf2; --gray:#7b8394; --otros:#33384a;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    background:
      radial-gradient(900px 420px at 20% -8%, #d9b25c0d, transparent 60%),
      radial-gradient(800px 420px at 100% 0%, #c7f22d09, transparent 60%),
      var(--bg-0);
    color:var(--text-hi);
    font-family:'Plus Jakarta Sans',sans-serif;
    margin:0;
    overflow-x:hidden;
  }
  .disp{font-family:'Space Grotesk',sans-serif;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .eyebrow{font-family:'JetBrains Mono',monospace; letter-spacing:.12em; text-transform:uppercase; font-size:10.5px; color:var(--text-low); font-weight:600;}
  .up{color:var(--green);} .down{color:var(--red);}
  ::selection{background:#d9b25c33;}
  .scroll-thin::-webkit-scrollbar{height:6px; width:6px;}
  .scroll-thin::-webkit-scrollbar-thumb{background:#242835; border-radius:10px;}
  .no-scrollbar::-webkit-scrollbar{display:none;}
  .no-scrollbar{-ms-overflow-style:none; scrollbar-width:none;}

  /* ---- APP SHELL ---- */
  .shell{display:flex; min-height:100vh;}
  .sidebar{
    width:76px; flex-shrink:0; background:var(--bg-sidebar); border-right:1px solid var(--line);
    display:flex; flex-direction:column; align-items:center; padding:20px 0; gap:6px;
  }
  .sb-logo{
    width:38px; height:38px; border:1px solid var(--gold); border-radius:8px;
    display:flex; align-items:center; justify-content:center; margin-bottom:24px;
    color:var(--gold); font-family:'Space Grotesk'; font-weight:700; font-size:15px; flex-shrink:0;
  }
  .sb-item{
    width:44px; height:44px; border-radius:9px; display:flex; align-items:center; justify-content:center;
    color:var(--text-low); cursor:pointer; transition:.15s; position:relative; flex-shrink:0;
  }
  .sb-item:hover{ color:var(--text-hi); background:#12141c; }
  .sb-item.active{ color:#0d0f16; background:var(--lime); }
  .sb-item svg{width:19px; height:19px;}
  .sb-spacer{flex:1;}
  .sb-avatar{width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,var(--gold),#8a6a2a); display:flex; align-items:center; justify-content:center; font-family:'Space Grotesk'; font-weight:700; font-size:12px; color:#12100a; flex-shrink:0;}
  .sb-close{display:none;}

  .main{flex:1; min-width:0; display:flex; flex-direction:column;}

  /* TOPBAR */
  .topbar{
    height:60px; border-bottom:1px solid var(--line); background:#07080cdd; backdrop-filter:blur(6px);
    display:flex; align-items:center; justify-content:space-between; padding:0 20px; gap:14px;
    position:sticky; top:0; z-index:20;
  }
  .crumbs{font-family:'JetBrains Mono'; font-size:11.5px; color:var(--text-low); display:flex; align-items:center; gap:7px; white-space:nowrap; overflow:hidden;}
  .crumbs b{color:var(--text-hi); font-weight:600;}
  .hamburger{
    display:none; width:36px; height:36px; align-items:center; justify-content:center;
    border:1px solid var(--line); border-radius:7px; cursor:pointer; color:var(--text-mid); flex-shrink:0;
    background:var(--panel-2);
  }
  .hamburger svg{width:18px;height:18px;}

  /* FILTER BAR */
  .filterbar{
    display:flex; align-items:center; gap:8px; overflow-x:auto; padding-bottom:2px; margin-bottom:20px;
  }
  .filterbar .fb-sep{width:1px; height:22px; background:var(--line); flex-shrink:0;}
  select.fselect{
    background:var(--panel-2); color:var(--text-hi); border:1px solid var(--line);
    border-radius:7px; padding:8px 30px 8px 12px; font-size:12px; outline:none; cursor:pointer;
    max-width:230px; flex-shrink:0; appearance:none; -webkit-appearance:none; font-family:'JetBrains Mono';
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6' fill='none'><path d='M1 1L5 5L9 1' stroke='%239aa0ae' stroke-width='1.5' stroke-linecap='round'/></svg>");
    background-repeat:no-repeat; background-position:right 11px center;
  }
  select.fselect:focus{border-color:var(--gold);}

  .chip{
    border:1px solid var(--line); border-radius:7px; padding:8px 14px; font-size:11.5px; font-family:'JetBrains Mono';
    color:var(--text-mid); white-space:nowrap; cursor:pointer; transition:.15s; background:var(--panel-2); flex-shrink:0;
    font-weight:600; letter-spacing:.02em;
  }
  .chip:hover{border-color:#333849; color:var(--text-hi);}
  .chip.active{background:var(--lime); color:#0d0f16; border-color:var(--lime);}
  .chip.active.risk-active{background:var(--red); border-color:var(--red); color:#1a0d0d;}

  /* CONTENT */
  .content{padding:20px 20px 40px; max-width:1500px; width:100%; margin:0 auto;}
  @media (min-width:768px){ .content{padding:28px 28px 40px;} }

  /* TECH PANEL */
  .tpanel{ position:relative; background:var(--panel); border:1px solid var(--line); border-radius:8px; }
  .tpanel::before, .tpanel::after{ content:''; position:absolute; width:9px; height:9px; pointer-events:none; }
  .tpanel::before{ top:-1px; left:-1px; border-top:1px solid var(--gold); border-left:1px solid var(--gold); border-top-left-radius:8px; }
  .tpanel::after{ bottom:-1px; right:-1px; border-bottom:1px solid var(--gold); border-right:1px solid var(--gold); border-bottom-right-radius:8px; }
  .tpanel-head{ display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--line-soft); gap:10px; flex-wrap:wrap; }
  .tpanel-body{padding:18px;}
  .tpanel-tag{ font-family:'JetBrains Mono'; font-size:9.5px; letter-spacing:.1em; text-transform:uppercase; color:#0d0f16; background:var(--lime); padding:2px 7px; border-radius:4px; font-weight:700; }

  .stat-card{ background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:16px 18px; position:relative; overflow:hidden; cursor:default; }
  .stat-card .glow{position:absolute; top:-30px; right:-30px; width:100px; height:100px; border-radius:50%; filter:blur(30px); opacity:.35; pointer-events:none;}

  .bar-track{background:#12141b; border-radius:5px; overflow:hidden; border:1px solid var(--line-soft);}

  .flag{border:1px solid #f8717133; background:linear-gradient(180deg,#f871710a,transparent); border-radius:8px;}
  .flag.ok{border-color:#4ade8033; background:linear-gradient(180deg,#4ade800a,transparent);}

  .fade-in{animation:fadeIn .22s ease;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(3px);} to{opacity:1; transform:translateY(0);}}

  table thead th{font-family:'JetBrains Mono';}
  tbody tr{transition:background .1s;}
  tbody tr:hover{background:#0f1119;}

  /* KPI tooltip */
  .has-tip{position:relative; cursor:help;}
  .has-tip .tip-ic{
    display:inline-flex; align-items:center; justify-content:center; width:13px; height:13px; border-radius:50%;
    border:1px solid var(--text-low); color:var(--text-low); font-size:9px; font-family:'JetBrains Mono'; margin-left:5px;
  }
  .has-tip::after{
    content:attr(data-tip); position:absolute; left:0; bottom:calc(100% + 8px); width:max-content; max-width:220px;
    background:#15171f; border:1px solid var(--line); color:var(--text-mid); font-size:11px; font-family:'Plus Jakarta Sans';
    padding:8px 10px; border-radius:7px; line-height:1.4; opacity:0; pointer-events:none; transform:translateY(4px);
    transition:.15s; z-index:30; box-shadow:0 8px 24px #000000aa;
  }
  .has-tip:hover::after{ opacity:1; transform:translateY(0); }

  /* ---- MOBILE DRAWER SIDEBAR ---- */
  .drawer-overlay{ position:fixed; inset:0; background:#000000b3; z-index:40; opacity:0; pointer-events:none; transition:opacity .2s; }
  .drawer-overlay.open{ opacity:1; pointer-events:auto; }
  @media (max-width:1023px){
    .hamburger{ display:flex; }
    .sidebar{
      position:fixed; left:0; top:0; bottom:0; z-index:50; width:220px;
      transform:translateX(-100%); transition:transform .25s ease; align-items:stretch; padding:16px;
      box-shadow:12px 0 32px #000000cc;
    }
    .sidebar.open{ transform:translateX(0); }
    .sidebar .sb-logo{ margin-bottom:16px; }
    .sb-item{ width:100%; justify-content:flex-start; gap:12px; padding:0 12px; }
    .sb-item span.lbl{ display:inline; font-size:13px; font-weight:600; font-family:'Space Grotesk'; }
    .sb-close{ display:flex; align-items:center; justify-content:center; width:30px; height:30px; border:1px solid var(--line); border-radius:6px; color:var(--text-mid); position:absolute; top:16px; right:16px; cursor:pointer; }
  }
  @media (min-width:1024px){
    .sb-item span.lbl{ display:none; }
  }
</style>
</head>
<body>

<div class="drawer-overlay" id="drawerOverlay"></div>

<div class="shell">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sb-close" id="sbClose">✕</div>
    <div class="sb-logo">E</div>
    <div class="sb-item active" title="Dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
      <span class="lbl">Dashboard</span>
    </div>
    <div class="sb-item" title="Clientes">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6"/><circle cx="18" cy="8" r="2.5"/><path d="M15.5 14.5c2.6.3 4.5 2.5 4.5 5.5"/></svg>
      <span class="lbl">Clientes</span>
    </div>
    <div class="sb-item" title="Ingresos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l5-5 4 4 8-9"/><path d="M14 7h6v6"/></svg>
