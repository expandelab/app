<script>
/* ===================================================================
   ExpandeLab · Cotizaciones Pagadas — Dashboard Engine
   Arquitectura: state -> compute*() [puras] -> render*() [DOM/Chart.js]
   =================================================================== */

const COLORS = { gold:'#d9b25c', lime:'#c7f22d', blue:'#6fa8ff', purple:'#b98cf2',
                 gray:'#7b8394', green:'#4ade80', red:'#f87171', otros:'#33384a' };
const PALETTE = [COLORS.gold, COLORS.lime, COLORS.blue, COLORS.purple, '#f0a35c', COLORS.gray, '#e0716b', '#6bd9c2', '#c9a8f2', '#8ab4f8'];
const MONTHS = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago*'];
const MONTHS_FULL = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto (parcial)'];
