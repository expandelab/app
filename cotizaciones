// Lista de clientes respetando el filtro de mes (revenue/count del mes o del total)
function clientEntries(monthIdx){
  return Object.entries(CLIENTS).map(([name,d])=>({
    name,
    total: monthIdx==null ? d.total : d.monthly[monthIdx],
    count: monthIdx==null ? d.count : d.monthlyCount[monthIdx],
    tipo: d.tipo,
  }));
}

// Algoritmo de riesgo (clientes recurrentes/relevantes con caída o inactividad)
function computeRiskClients(){
  return Object.entries(CLIENTS).map(([name,d])=>{
    const activeIdxs = d.monthly.map((v,i)=>v>0?i:-1).filter(i=>i>=0);
    if(activeIdxs.length===0) return null;
    const lastActive = activeIdxs[activeIdxs.length-1];
    const monthsInactive = LAST_MONTH_IDX - lastActive;
    const peak = Math.max(...d.monthly);
    const peakIdx = d.monthly.indexOf(peak);
    const lastVal = d.monthly[lastActive];
    const dropRatio = peak>0 ? (peak-lastVal)/peak : 0;

    const isRecurring = d.count>=2;
    const isMeaningful = d.total>=300;
    let reason=null, type=null, severity=0;

    if(isRecurring && isMeaningful && monthsInactive>=2){
      reason = `Sin compras hace ${monthsInactive} meses (última: ${d.last})`;
      type = 'inactivo';
      severity = monthsInactive*10 + d.total/1000;
    } else if(isRecurring && isMeaningful && peakIdx < lastActive && dropRatio>=0.6){
      reason = `Caída de ${Math.round(dropRatio*100)}% desde su mes pico`;
      type = 'caida';
      severity = dropRatio*10 + d.total/1000;
    }
    if(!reason) return null;
    return { name, total:d.total, count:d.count, pct:+(d.total/TOTAL_ALL*100).toFixed(2), monthsInactive, dropRatio, reason, type, severity };
  }).filter(Boolean).sort((a,b)=>b.severity-a.severity);
}
const RISK_CLIENTS = computeRiskClients(); // se calcula una sola vez
const RISK_TOTAL = RISK_CLIENTS.reduce((s,c)=>s+c.total,0);

// Top-N clientes por total (respetando filtro de mes), con paleta asignada
function topClientsBy(n, monthIdx){
  const denom = monthIdx==null ? TOTAL_ALL : monthlyRevenue[monthIdx];
  return clientEntries(monthIdx)
    .filter(c=>c.total>0)
    .sort((a,b)=>b.total-a.total)
    .slice(0,n)
    .map((c,i)=>({ ...c, pct:+(c.total/denom*100).toFixed(2), color:PALETTE[i%PALETTE.length] }));
}

// KPI dataset segun el estado actual
function computeKPIs(){
  const { mode, client, month } = state;

  if(client){
    const d = CLIENTS[client];
    if(month!=null){
      const rev = d.monthly[month], cnt = d.monthlyCount[month];
      return {
        label: client, main: fmt(rev), badge: `${MONTHS_FULL[month]} · ${pct1(d.total? rev/d.total*100:0)} del total del cliente`,
        tile1Label:'Ticket promedio', tile1Val: cnt? fmt(rev/cnt) : '—',
        tile2Label:'Cotizaciones', tile2Val: cnt,
        tile3Label:'% de la cartera ese mes', tile3Val: pct1(monthlyRevenue[month]? rev/monthlyRevenue[month]*100:0),
        tile4Val: pct1(d.pct), tile5Label:'peso en cartera total', tile5Val: pct1(d.pct),
      };
    }
    return {
      label: client, main: fmt(d.total), badge: `${pct1(d.pct)} de la cartera total`,
      tile1Label:'Ticket promedio', tile1Val: fmt(d.total/d.count),
      tile2Label:'Cotizaciones pagadas', tile2Val: d.count,
      tile3Label:'Primera compra', tile3Val: d.first,
      tile4Val: d.count>=2 ? 'Sí' : 'No', tile5Label:'Última compra', tile5Val: d.last,
    };
  }

  if(month!=null){
    const rev = monthlyRevenue[month], cnt = monthlyCount[month];
    const activeClients = clientEntries(month).filter(c=>c.total>0).length;
    const prevRet = month>0 ? MOM_RETENTION[month-1] : null;
    return {
      label: `Ingresos · ${MONTHS_FULL[month]}`, main: fmt(rev),
      badge: month>0 ? `${rev>=monthlyRevenue[month-1]?'▲':'▼'} vs ${MONTHS[month-1]}: ${pct1(Math.abs((rev-monthlyRevenue[month-1])/monthlyRevenue[month-1]*100))}` : 'primer mes del periodo',
      tile1Label:'Ticket promedio', tile1Val: fmt(rev/cnt),
      tile2Label:'Cotizaciones', tile2Val: cnt,
      tile3Label:'Clientes activos', tile3Val: activeClients,
      tile4Val: prevRet!=null ? pct1(prevRet) : 'N/A',
      tile5Label:'retención vs mes anterior', tile5Val: prevRet!=null ? pct1(prevRet) : '—',
    };
  }

  if(mode==='top'){
    const top10 = topClientsBy(10, null);
    const sum = top10.reduce((s,c)=>s+c.total,0);
    const cnt = top10.reduce((s,c)=>s+c.count,0);
    return {
      label:'Ingresos · Top 10 clientes', main: fmt(sum), badge:`${pct1(sum/TOTAL_ALL*100)} del total de cartera`,
      tile1Label:'Ticket promedio (top 10)', tile1Val: fmt(sum/cnt),
      tile2Label:'Cotizaciones (top 10)', tile2Val: cnt,
      tile3Label:'Clientes en este grupo', tile3Val: 10,
      tile4Val: pct1(N_REPEAT/N_CLIENTS*100), tile5Label:'peso sobre cartera total', tile5Val: pct1(sum/TOTAL_ALL*100),
    };
  }

  if(mode==='risk'){
    const invTypes = RISK_CLIENTS.filter(c=>c.type==='inactivo').length;
    const dropTypes = RISK_CLIENTS.filter(c=>c.type==='caida').length;
    return {
      label:'Ingresos en riesgo', main: fmt(RISK_TOTAL), badge:`${pct1(RISK_TOTAL/TOTAL_ALL*100)} de la cartera total`,
      tile1Label:'Clientes en riesgo', tile1Val: RISK_CLIENTS.length + ' / ' + N_CLIENTS,
      tile2Label:'Por inactividad (2+ meses)', tile2Val: invTypes,
      tile3Label:'Por caída brusca (≥60%)', tile3Val: dropTypes,
      tile4Val: pct1(N_REPEAT/N_CLIENTS*100), tile5Label:'retención mensual (M/M)', tile5Val: '66.2%',
    };
  }

  // mode === 'all'
  return {
    label:'Ingresos pagados · Ene–Ago 2026', main: fmt(TOTAL_ALL), badge:'▲ 22.8% jul vs ene',
    tile1Label:'Ticket promedio', tile1Val: fmt(TOTAL_ALL/N_INVOICES),
    tile2Label:'Cotizaciones pagadas', tile2Val: N_INVOICES.toLocaleString('es-PE'),
    tile3Label:'Clientes activos', tile3Val: N_CLIENTS,
    tile4Val: pct1(N_REPEAT/N_CLIENTS*100), tile5Label:'retención mensual (M/M)', tile5Val: '66.2%',
  };
}

